# ── Sensitive / proprietary data ──────────────────────────────────────────────
# Top-level raw & processed data directories (contain player-level CSVs)
data/
# Outcome-summary CSVs and processed outputs in results/
results/
# Raw / intermediate data nested inside analysis/
analysis/data/
# Notion integration folder (may contain API tokens, page exports)
notion/

# ── Secrets ───────────────────────────────────────────────────────────────────
.env
.env.*
!.env.example

# ── Python artifacts ──────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
dist/
build/

# ── Python tooling caches ─────────────────────────────────────────────────────
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# ── Virtual environments ──────────────────────────────────────────────────────
.venv/
venv/
env/

# ── OS / editor artifacts ─────────────────────────────────────────────────────
.DS_Store
.vscode/
*.swp
*.swo

# ── OneDrive / Office / sync noise ────────────────────────────────────────────
# Temp and lock files created by Office apps and OneDrive sync
*.tmp
~$*
*.bak
*.orig
# Windows shortcut / URL files that OneDrive sometimes syncs
*.lnk
*.url
# Partial downloads and iCloud/OneDrive sync-in-progress markers
*.partial
*.icloud
# OneDrive conflict copies (e.g. file-sync-conflict-2026-05-27.csv)
*sync-conflict-*

# ── Cleanup manifests (generated locally, not needed in repo) ─────────────────
CLEANUP_MANIFEST_*.txt

# ── Temporary outputs ─────────────────────────────────────────────────────────
.tmp/
fig_outputs/
archive/
